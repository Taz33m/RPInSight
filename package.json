{
  "name": "rpinsight",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted RPI campus map with curated geospatial data, campus search, and Mapbox directions.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-pattern next-env.d.ts",
    "check": "npm run type-check && npm run lint && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.456.0",
    "mapbox-gl": "^3.7.0",
    "next": "^15.5.18",
    "openai": "^4.71.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.0.3",
    "json-loader": "^0.5.7",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion": "^1.1.13",
    "postcss": "$postcss"
